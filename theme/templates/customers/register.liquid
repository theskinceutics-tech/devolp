<section class="section"><div class="container" style="max-width:480px">
  <h1 class="text-center">Create account</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RegFirst">First name</label><input class="input" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="RegLast">Last name</label><input class="input" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="RegEmail">Email</label><input class="input" type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="RegPassword">Password</label><input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
    <label class="checkbox" style="margin-bottom:16px"><input type="checkbox" name="customer[accepts_marketing]" value="true"> Email me skincare education and store news</label>
    <button class="btn btn--block" type="submit">Create account</button>
  {%- endform -%}
  <p class="text-center" style="margin-top:20px">Already have an account? <a href="{{ routes.account_login_url }}">Sign in</a></p>
</div></section>

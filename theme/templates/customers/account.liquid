<section class="section"><div class="container">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <h1 style="margin:0">My account</h1>
    <a href="{{ routes.account_logout_url }}" class="link-arrow">Log out</a>
  </div>
  <div class="split" style="align-items:start;margin-top:32px">
    <div>
      <h2 class="h3">Order history</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="rte" style="width:100%;border-collapse:collapse;font-size:14px">
            <thead><tr><th style="text-align:left;padding:8px 0">Order</th><th style="text-align:left">Date</th><th style="text-align:left">Payment</th><th style="text-align:left">Fulfilment</th><th style="text-align:right">Total</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr style="border-top:1px solid var(--c-line)"><td style="padding:10px 0"><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: format: 'date' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td style="text-align:right">{{ order.total_price | money_with_currency }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <p class="muted">You haven't placed any orders yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">Start shopping</a>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="h3">Account details</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {{ customer.default_address | format_address }}
      <p><a href="{{ routes.account_addresses_url }}" class="link-arrow">View addresses ({{ customer.addresses_count }})</a></p>
    </div>
  </div>
</div></section>

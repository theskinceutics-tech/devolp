<section class="section"><div class="container" style="max-width:760px">
  <p><a href="{{ routes.account_url }}" class="link-arrow">Back to account</a></p>
  <h1>Addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div style="border:1px solid var(--c-line);padding:20px;margin-bottom:16px">
        {%- if address == customer.default_address -%}<span class="badge" style="padding-left:0">Default</span>{%- endif -%}
        {{ address | format_address }}
        <details style="margin-top:12px"><summary class="link-arrow" style="cursor:pointer">Edit</summary>
          {%- form 'customer_address', address -%}
            {%- render 'address-fields', form: form, id: address.id -%}
            <button class="btn" type="submit">Update address</button>
          {%- endform -%}
        </details>
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="margin-top:10px">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="cart-item__remove" onclick="return confirm('Delete this address?')">Delete</button>
        </form>
      </div>
    {%- endfor -%}
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
  <details{% if customer.addresses.size == 0 %} open{% endif %} style="margin-top:24px"><summary class="btn btn--outline">Add a new address</summary>
    <div style="margin-top:20px">
      {%- form 'customer_address', customer.new_address -%}
        {%- render 'address-fields', form: form, id: 'new' -%}
        <button class="btn" type="submit">Add address</button>
      {%- endform -%}
    </div>
  </details>
</div></section>

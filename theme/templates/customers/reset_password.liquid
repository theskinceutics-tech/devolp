<section class="section"><div class="container" style="max-width:480px">
  <h1 class="text-center">Reset password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">New password</label><input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">Confirm password</label><input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--block" type="submit">Reset password</button>
  {%- endform -%}
</div></section>

{%- comment -%} Params: id, name, value, min, max, label, line {%- endcomment -%}
<div class="qty" data-qty>
  <button type="button" data-qty-minus aria-label="Decrease quantity{% if label %} for {{ label | escape }}{% endif %}">{% render 'icon', name: 'minus' %}</button>
  <input type="number" id="{{ id }}" name="{{ name | default: 'quantity' }}" value="{{ value | default: 1 }}" min="{{ min | default: 1 }}"{% if max %} max="{{ max }}"{% endif %} inputmode="numeric" aria-label="Quantity{% if label %} for {{ label | escape }}{% endif %}"{% if line %} data-line="{{ line }}"{% endif %}>
  <button type="button" data-qty-plus aria-label="Increase quantity{% if label %} for {{ label | escape }}{% endif %}">{% render 'icon', name: 'plus' %}</button>
</div>

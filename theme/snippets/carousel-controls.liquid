<div class="carousel__controls">
  <button type="button" class="carousel__btn" data-carousel-prev aria-label="Previous slides">{% render 'icon', name: 'chevron-left' %}</button>
  <div class="carousel__bar" aria-hidden="true"><span></span></div>
  <button type="button" class="carousel__btn" data-carousel-next aria-label="Next slides">{% render 'icon', name: 'chevron-right' %}</button>
</div>

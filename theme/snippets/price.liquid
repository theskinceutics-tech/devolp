{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
  assign varies = false
  if use_range and product.price_varies
    assign varies = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  <span class="visually-hidden">{% if on_sale %}Sale price{% else %}Price{% endif %}</span>
  <span class="price__current">{% if varies %}From {{ product.price_min | money }}{% else %}{{ target.price | money }}{% endif %}</span>
  {%- if on_sale and varies == false -%}
    <span class="visually-hidden">Regular price</span>
    <s class="price__compare">{{ target.compare_at_price | money }}</s>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">{{ target.unit_price | money }}/{% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif %}{{ target.unit_price_measurement.reference_unit }}</span>
  {%- endif -%}
</div>

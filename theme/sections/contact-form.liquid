<section class="section">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">Thank you — our team will get back to you soon.</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="grid grid--2" style="--grid-gap:0 16px">
        <div class="field"><label for="ContactName">Name</label><input class="input" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="field"><label for="ContactEmail">Email *</label><input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      </div>
      <div class="field"><label for="ContactPhone">Phone</label><input class="input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
      <div class="field"><label for="ContactBody">Message *</label><textarea class="input" id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
      <button type="submit" class="btn">Send message</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}

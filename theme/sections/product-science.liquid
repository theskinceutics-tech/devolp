{%- liquid
  assign s = section.settings
  assign text = product.metafields.custom.science_text.value
  assign heading = product.metafields.custom.science_heading.value | default: s.heading
  assign img = product.metafields.custom.science_image.value
  assign stats = product.metafields.custom.results.value
-%}
{%- if text != blank or stats != blank -%}
<section class="section {% render 'section-class', style: s.style %} reveal" id="ProductScience">
  <div class="container">
    <div class="section-head">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | replace: '[product]', product.title | escape }}</span>{%- endif -%}
      <h2>{{ heading | replace: '[product]', product.title | escape }}</h2>
    </div>
    {%- if stats != blank -%}
      <div class="stats">
        {%- for row in stats -%}
          {%- assign parts = row | split: '|' -%}
          <div class="stats__item"><strong>{{ parts[0] | strip | escape }}</strong><span>{{ parts[1] | strip | escape }}</span></div>
        {%- endfor -%}
      </div>
      {%- if product.metafields.custom.results_note.value != blank -%}<p class="text-center muted" style="font-size:12px;margin:-12px 0 40px">{{ product.metafields.custom.results_note.value | escape }}</p>{%- endif -%}
    {%- endif -%}
    {%- if text != blank -%}
      <div class="split">
        <div class="split__media">
          {%- if img != blank -%}
            {%- render 'media', image: img, ratio: '4/3', sizes: '(min-width: 900px) 50vw, 100vw' -%}
          {%- else -%}
            {%- assign alt_img = product.media[2].preview_image | default: product.featured_media.preview_image -%}
            <div class="media media--contain" style="--ratio:4/3;background:var(--grad-light)">{%- if alt_img -%}{%- render 'image', image: alt_img, sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title -%}{%- else -%}{%- render 'art', variant: 5 -%}{%- endif -%}</div>
          {%- endif -%}
        </div>
        <div class="split__content"><div class="rte">{{ text | escape | newline_to_br }}</div></div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Product science",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "[product]" },
    { "type": "text", "id": "heading", "label": "Default heading", "default": "The science behind the formula" },
    { "type": "select", "id": "style", "label": "Background", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }] },
    { "type": "paragraph", "content": "Metafields: custom.science_heading, custom.science_text (multi-line), custom.science_image (file). Optional documented results: custom.results (list, format: 20% | description) and custom.results_note. Hidden when empty — never shows invented data." }
  ]
}
{% endschema %}

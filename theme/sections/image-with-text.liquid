{%- liquid
  assign s = section.settings
  assign dark = false
  if s.style == 'dark' or s.style == 'accent'
    assign dark = true
  endif
  assign product = s.product
  case s.ratio
    when 'portrait'
      assign ratio = '4/5'
    when 'landscape'
      assign ratio = '4/3'
    when 'wide'
      assign ratio = '16/10'
    else
      assign ratio = '1/1'
  endcase
  assign tag = 'h2'
  if s.as_h1
    assign tag = 'h1'
  endif
  assign media_class = ''
  if s.bleed
    assign media_class = 'media--bleed'
  endif
-%}
<section class="{% unless s.bleed %}section {% endunless %}{% render 'section-class', style: s.style %} reveal">
  <div class="{% unless s.bleed %}container{% endunless %}">
    <div class="split{% if s.media_side == 'right' %} split--media-right{% endif %}{% if s.bleed %} split--bleed{% endif %}{% if s.wide_media %} split--wide-media{% endif %}">
      <div class="split__media">
        {%- render 'media', image: s.image, product: product, ratio: ratio, sizes: '(min-width: 900px) 50vw, 100vw', variant: s.art, tone: s.style, contain: s.contain, class: media_class -%}
      </div>
      <div class="split__content">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<{{ tag }}>{{ s.heading | escape }}</{{ tag }}>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="accordion" style="margin-top:24px">
            {%- for block in section.blocks -%}
              <details class="accordion__item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title | escape }} {% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__content rte">{{ block.settings.text }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="split__actions">
          {%- render 'button', label: s.button_label, link: s.button_link, dark: dark, variant: s.button_style -%}
          {%- render 'button', label: s.button2_label, link: s.button2_link, dark: dark, variant: 'outline' -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Product image fallback", "info": "Shown when no image is uploaded. Without both, original Elysium artwork is shown." },
    { "type": "select", "id": "art", "label": "Artwork style (fallback)", "default": "1", "options": [{ "value": "1", "label": "Molecule" }, { "value": "2", "label": "Rings" }, { "value": "3", "label": "Helix" }, { "value": "4", "label": "Dots" }, { "value": "5", "label": "Hexagon" }] },
    { "type": "checkbox", "id": "contain", "label": "Fit image without cropping", "default": false },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "square", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait 4:5" }, { "value": "landscape", "label": "Landscape 4:3" }, { "value": "wide", "label": "Wide 16:10" }] },
    { "type": "select", "id": "media_side", "label": "Image position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "checkbox", "id": "bleed", "label": "Full-width edge-to-edge layout", "default": false },
    { "type": "checkbox", "id": "wide_media", "label": "Wider image column", "default": false },
    { "type": "select", "id": "style", "label": "Background", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }, { "value": "blue", "label": "Light blue" }, { "value": "gradient", "label": "Blue gradient" }, { "value": "dark", "label": "Dark" }, { "value": "accent", "label": "Brand blue" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Image with text" },
    { "type": "checkbox", "id": "as_h1", "label": "Use as page main heading (H1)", "default": false },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair an image with a short editorial story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "outline", "options": [{ "value": "primary", "label": "Solid" }, { "value": "outline", "label": "Outline" }, { "value": "accent", "label": "Brand blue" }] },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "accordion", "name": "Accordion row", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Learn more" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Details.</p>" }
    ] }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}

{%- assign s = section.settings -%}
<section class="section {% render 'section-class', style: s.style %} reveal" id="routine-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <div data-tabs>
      <div class="tabs__list" role="tablist" aria-label="{{ s.heading | escape }}">
        {%- for block in section.blocks -%}
          <button type="button" class="tabs__tab" role="tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign q = b.search_terms | default: b.label | url_param_escape
          assign remote = routes.search_url | append: '?type=product&q=' | append: q | append: '&section_id=routine-results'
          assign browse = routes.search_url | append: '?type=product&q=' | append: q
          if b.collection != blank
            assign browse = b.collection.url
          endif
        -%}
        <div class="tabs__panel" role="tabpanel" id="Panel-{{ block.id }}" aria-labelledby="Tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}{% if b.products == blank and b.collection == blank %} data-remote="{{ remote }}"{% endif %}>
          {%- if b.title != blank or b.text != blank -%}
            <div class="text-center" style="max-width:680px;margin:0 auto 28px">
              {%- if b.title != blank -%}<h3>{{ b.title | escape }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<p class="muted">{{ b.text | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}
          <div class="grid grid--products" style="--cols-desktop:4" data-remote-target>
            {%- if b.products != blank -%}
              {%- for product in b.products -%}<div><span class="eyebrow" style="font-size:10.5px">Step {{ forloop.index }}</span>{%- render 'product-card', product: product -%}</div>{%- endfor -%}
            {%- elsif b.collection != blank -%}
              {%- for product in b.collection.products limit: 4 -%}{%- render 'product-card', product: product -%}{%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}<div aria-hidden="true"><div class="media" style="--ratio:1/1">{%- render 'art', variant: i -%}</div><div style="height:14px;background:var(--c-line);margin-top:16px;width:70%"></div><div style="height:12px;background:var(--c-line);margin-top:10px;width:40%"></div></div>{%- endfor -%}
            {%- endif -%}
          </div>
          <p class="text-center muted" data-remote-empty hidden>We're updating recommendations for this concern. <a href="{{ routes.all_products_collection_url }}">Browse all products</a>.</p>
          <div class="section-foot"><a href="{{ browse }}" class="btn btn--outline">{{ b.link_label | default: 'See all products' | escape }}</a></div>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Routine builder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What would you like to focus on?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a concern to see the Elysium products made for it." },
    { "type": "select", "id": "style", "label": "Background", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }, { "value": "blue", "label": "Light blue" }] }
  ],
  "blocks": [
    { "type": "routine", "name": "Concern routine", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "Tab label", "default": "Acne-prone" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "product_list", "id": "products", "label": "Routine products (in order)", "limit": 4, "info": "Best option: pick the exact routine. Shown as Step 1, 2, 3…" },
      { "type": "collection", "id": "collection", "label": "Or a collection" },
      { "type": "text", "id": "search_terms", "label": "Or search terms", "info": "Used only when no products or collection are selected. Matches your real product catalogue.", "default": "acne" },
      { "type": "text", "id": "link_label", "label": "Button label", "default": "See all products" }
    ] }
  ],
  "presets": [{ "name": "Routine builder", "blocks": [{ "type": "routine" }] }]
}
{% endschema %}

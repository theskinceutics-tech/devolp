{%- if section.settings.menu.links.size > 0 -%}
<div class="container">
  <nav class="link-row" aria-label="{{ section.settings.heading | escape }}">
    <strong>{{ section.settings.heading | escape }}</strong>
    {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }} {% render 'icon', name: 'chevron-right', class: 'icon--sm' %}</a>{%- endfor -%}
  </nav>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Also of interest links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Also of interest" },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Hidden until a menu with links is selected." }
  ],
  "presets": [{ "name": "Also of interest links" }]
}
{% endschema %}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign active = 0
  for f in search.filters
    assign active = active | plus: f.active_values.size
  endfor
-%}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer></script>
<section class="collection-hero">
  <div class="container collection-hero__inner">
    <div>
      <h1>{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:8px;max-width:560px;margin-top:16px">
        <label for="SearchPage" class="visually-hidden">Search</label>
        <input type="search" id="SearchPage" name="q" class="input" value="{{ search.terms | escape }}" placeholder="Search products, ingredients and advice">
        <button type="submit" class="btn">Search</button>
      </form>
    </div>
  </div>
</section>
{%- if search.performed -%}
{%- paginate search.results by 24 -%}
<div class="container collection">
  <div class="collection__bar">
    {%- if search.filters.size > 0 -%}<button type="button" class="btn btn--outline btn--small collection__filter-btn" data-drawer-open="FacetsDrawer" aria-controls="FacetsDrawer" aria-expanded="false">Filter{% if active > 0 %} ({{ active }}){% endif %}</button>{%- endif -%}
    <p class="collection__count" role="status">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p>
  </div>
  <div class="collection__layout{% if search.filters.size > 0 %} has-filters{% endif %}">
    {%- if search.filters.size > 0 -%}{%- render 'facets', results: search, sort_by: sort_by, active: active, terms: search.terms -%}{%- endif -%}
    <div>
      {%- if search.results_count > 0 -%}
        <h2 class="visually-hidden">Results</h2>
        <ul class="grid grid--products" style="list-style:none;padding:0;margin:0;--cols-desktop:{% if search.filters.size > 0 %}3{% else %}4{% endif %}" role="list">
          {%- for item in search.results -%}
            <li>
              {%- case item.object_type -%}
                {%- when 'product' -%}{%- render 'product-card', product: item -%}
                {%- when 'article' -%}
                  <a href="{{ item.url }}" class="article-card">{%- render 'media', image: item.image, ratio: '1/1', variant: forloop.index -%}<span class="article-card__tag">Article</span><h3>{{ item.title | escape }}</h3><p>{{ item.excerpt_or_content | strip_html | truncatewords: 16 }}</p></a>
                {%- else -%}
                  <a href="{{ item.url }}" class="article-card"><div class="media" style="--ratio:1/1">{%- render 'art', variant: forloop.index -%}</div><span class="article-card__tag">Page</span><h3>{{ item.title | escape }}</h3><p>{{ item.content | strip_html | truncatewords: 16 }}</p></a>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="empty-state">
          <h2 class="h3">No results found</h2>
          <p>Check the spelling or try a broader term such as “serum” or “acne”.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Shop all products</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endpaginate -%}
{%- endif -%}
{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}

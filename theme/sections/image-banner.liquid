{%- liquid
  assign s = section.settings
  assign banner_product = s.product
  if banner_product == blank and request.page_type == 'product'
    assign banner_product = product
  endif
-%}
<section class="section section--flush reveal">
  <div class="{% if s.full_width %}{% else %}container{% endif %}">
    <div class="media" style="--ratio:auto;min-height:{{ s.height }}px;background:var(--c-dark);display:flex;align-items:center">
      {%- if s.image != blank -%}
        {%- render 'image', image: s.image, sizes: '100vw', widths: '750,1100,1500,1920' -%}
      {%- elsif banner_product.featured_media -%}
        <div style="position:absolute;inset:0;background:var(--grad-blue)"></div>
        <div style="position:absolute;right:4%;top:8%;bottom:8%;width:min(46%,520px)" class="banner-product">{{ banner_product.featured_media.preview_image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '45vw', loading: 'lazy', style: 'width:100%;height:100%;object-fit:contain', alt: banner_product.title }}</div>
      {%- else -%}
        {%- render 'art', variant: 2, tone: 'dark' -%}
      {%- endif -%}
      <div style="position:relative;z-index:1;width:100%" class="{% if s.full_width %}container{% endif %}">
        <div style="max-width:520px;background:{% if s.box %}rgba(14,17,20,.78){% else %}transparent{% endif %};color:#fff;padding:clamp(24px,4vw,48px);margin:24px{% if s.full_width %} 0{% endif %}">
          {%- if s.eyebrow != blank -%}<span class="eyebrow" style="color:#bcd6f2">{{ s.eyebrow | escape }}</span>{%- endif -%}
          <h2>{{ s.heading | escape }}</h2>
          {%- if s.text != blank -%}<p style="opacity:.85">{{ s.text | escape }}</p>{%- endif -%}
          <div class="split__actions">{%- render 'button', label: s.button_label, link: s.button_link, dark: true, variant: 'outline' -%}</div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>@media (max-width:749px){#shopify-section-{{ section.id }} .banner-product{position:relative!important;inset:auto!important;width:70%!important;height:260px!important;margin:24px auto 0}#shopify-section-{{ section.id }} .media{flex-direction:column}}</style>
{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Product image fallback" },
    { "type": "range", "id": "height", "label": "Minimum height", "min": 300, "max": 700, "step": 20, "default": 460, "unit": "px" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "checkbox", "id": "box", "label": "Dark text box", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Impact driven by science" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}

{%- liquid
  assign text = section.settings.text
  assign key = text | handle | slice: 0, 40
-%}
{%- if text != blank -%}
<div class="announcement" data-announcement="{{ key }}" id="Announcement-{{ section.id }}">
  <div class="container announcement__inner">
    <p>
      {%- capture ann_url -%}{%- render 'safe-url', url: section.settings.link -%}{%- endcapture -%}
      {%- assign ann_url = ann_url | strip -%}
      {%- if ann_url != blank -%}<a href="{{ ann_url }}">{{ text | escape }}</a>{%- else -%}{{ text | escape }}{%- endif -%}
    </p>
    {%- if section.settings.dismissible -%}
      <button type="button" class="announcement__close" data-announcement-close aria-label="Dismiss announcement">{% render 'icon', name: 'close', class: 'icon--sm' %}</button>
    {%- endif -%}
  </div>
</div>
{%- if section.settings.dismissible -%}
<script>try{if(localStorage.getItem('elysium-ann-{{ key }}'))document.getElementById('Announcement-{{ section.id }}').hidden=true}catch(e){}</script>
{%- endif -%}
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Official Elysium Skin Sciences store — shop authentic products direct from the brand", "info": "Only publish real offers and confirmed shipping terms." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "dismissible", "label": "Allow visitors to close", "default": false }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}

{%- assign s = section.settings -%}
{%- if product.description != blank -%}
<section class="section {% render 'section-class', style: s.style %} reveal" id="ProductDetails">
  <div class="container">
    <div class="split split--media-right">
      <div class="split__media">
        {%- assign img = product.media[1].preview_image | default: product.featured_media.preview_image -%}
        <div class="media media--contain" style="--ratio:1/1;background:{% if s.style == 'dark' %}#1a1f24{% else %}var(--c-surface){% endif %}">
          {%- if img -%}{%- render 'image', image: img, sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title -%}{%- else -%}{%- render 'art', variant: 4, tone: s.style -%}{%- endif -%}
        </div>
      </div>
      <div class="split__content" style="max-width:600px">
        <h2>{{ s.heading | replace: '[product]', product.title | escape }}</h2>
        <div class="rte{% if product.description.size > 900 %} read-more{% endif %}" id="Desc-{{ section.id }}">{{ product.description }}</div>
        {%- if product.description.size > 900 -%}
          <button type="button" class="link-arrow" style="background:none;border:0;padding:0;margin-top:14px;color:inherit" data-read-more aria-controls="Desc-{{ section.id }}" aria-expanded="false" data-more="Read more" data-less="Read less">Read more</button>
        {%- endif -%}
        <div class="split__actions">
          {%- if product.metafields.custom.how_to_use.value != blank or product.metafields.custom.how_to_use_text.value != blank -%}<a href="#HowToUse" class="link-arrow">How to use {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
          {%- if product.metafields.custom.faq.value != blank -%}<a href="#ProductFaq" class="link-arrow">See FAQs {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "[product] details" },
    { "type": "select", "id": "style", "label": "Background", "default": "dark", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }, { "value": "dark", "label": "Dark" }] },
    { "type": "paragraph", "content": "Uses the existing product description unchanged." }
  ]
}
{% endschema %}

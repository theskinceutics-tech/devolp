{%- liquid
  assign s = section.settings
  assign letters = ''
  for block in section.blocks
    assign l = block.settings.name | slice: 0 | upcase
    unless letters contains l
      assign letters = letters | append: l
    endunless
  endfor
  assign letter_list = letters | split: ''
-%}
<section class="section">
  <div class="container">
    <div class="section-head section-head--left">
      <h2>{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <nav aria-label="Ingredients by letter" class="tabs__list" style="justify-content:flex-start;margin-bottom:40px">
      {%- for l in letter_list -%}<a class="tabs__tab" style="display:inline-flex;align-items:center;text-decoration:none;min-width:40px;justify-content:center" href="#letter-{{ l | downcase }}">{{ l }}</a>{%- endfor -%}
    </nav>
    {%- for l in letter_list -%}
      <div id="letter-{{ l | downcase }}" style="scroll-margin-top:140px;padding-block:20px;border-top:1px solid var(--c-line);display:grid;grid-template-columns:60px 1fr;gap:16px">
        <p class="h2" style="margin:0;color:var(--c-accent)">{{ l }}</p>
        <div class="grid grid--3" style="--grid-gap:24px">
          {%- for block in section.blocks -%}
            {%- assign first = block.settings.name | slice: 0 | upcase -%}
            {%- if first == l -%}
              {%- liquid
                assign url = block.settings.link
                if url == blank
                  assign h = block.settings.name | handle
                  if pages[h]
                    assign url = pages[h].url
                  else
                    assign q = block.settings.name | url_param_escape
                    assign url = routes.search_url | append: '?q=' | append: q
                  endif
                endif
              -%}
              <a href="{{ url }}" class="concern" style="min-height:0;gap:10px" {{ block.shopify_attributes }}>
                <span class="concern__title">{{ block.settings.name | escape }}</span>
                {%- if block.settings.text != blank -%}<span class="concern__text">{{ block.settings.text | escape }}</span>{%- endif -%}
                <span class="concern__go">Learn more {% render 'icon', name: 'arrow', class: 'icon--sm' %}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Ingredient directory",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredient glossary" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The actives and technologies used across Elysium formulas, explained." }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
      { "type": "textarea", "id": "text", "label": "Short description" },
      { "type": "url", "id": "link", "label": "Link", "info": "Defaults to a page with the same handle (e.g. /pages/pdrn), then a store search." }
    ] }
  ],
  "presets": [{ "name": "Ingredient directory", "blocks": [{ "type": "ingredient" }] }]
}
{% endschema %}

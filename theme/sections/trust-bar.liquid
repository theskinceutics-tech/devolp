<div class="section--dark" style="background:#1d2126">
  <div class="trust">
    <div class="trust__items">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="trust__item" {{ block.shopify_attributes }}>{%- else -%}<div class="trust__item" {{ block.shopify_attributes }}>{%- endif -%}
          {%- render 'icon', name: block.settings.icon -%}
          <span>{{ block.settings.title | escape }}</span>
          {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.panel_heading != blank -%}
      <div class="trust__panel">
        <h3>{{ section.settings.panel_heading | escape }}</h3>
        <p>{{ section.settings.panel_text | escape }}</p>
        {%- if section.settings.panel_link != blank -%}<a href="{{ section.settings.panel_link }}" class="link-arrow" style="color:#fff">{{ section.settings.panel_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Reassurance band",
  "settings": [
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "Shop authentic Elysium" },
    { "type": "text", "id": "panel_text", "label": "Panel text", "default": "Buy directly from the official Elysium Skin Sciences store to make sure you receive genuine products." },
    { "type": "url", "id": "panel_link", "label": "Panel link", "default": "/pages/about" },
    { "type": "text", "id": "panel_link_label", "label": "Panel link label", "default": "About Elysium" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
        { "value": "shield", "label": "Shield" }, { "value": "chat", "label": "Chat" }, { "value": "routine", "label": "Routine" }, { "value": "lock", "label": "Lock" },
        { "value": "truck", "label": "Delivery" }, { "value": "flask", "label": "Flask" }, { "value": "mail", "label": "Mail" }, { "value": "whatsapp", "label": "WhatsApp" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Authentic products" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Reassurance band" }]
}
{% endschema %}

<section class="hero hero--product" style="--hero-bg:var(--grad-blue);--hero-h:100vh;--hero-h-m:100vh">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if settings.logo -%}{{ settings.logo | image_url: width: 400 | image_tag: loading: 'eager', style: 'width:200px;margin-bottom:32px', alt: shop.name }}{%- else -%}<p class="header__logo-text" style="margin-bottom:32px">{{ shop.name }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'customer', style: 'display:flex;gap:8px;margin-top:24px;max-width:460px' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}<p>Thank you — we'll be in touch.</p>{%- else -%}
        <label for="PwEmail" class="visually-hidden">Email</label>
        <input class="input" id="PwEmail" type="email" name="contact[email]" placeholder="Email address" required>
        <button class="btn btn--light" type="submit">Notify me</button>{%- endif -%}
      {%- endform -%}
      <details style="margin-top:40px">
        <summary style="cursor:pointer">Enter store password</summary>
        {%- form 'storefront_password', style: 'display:flex;gap:8px;margin-top:12px;max-width:460px' -%}
          {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label for="PwInput" class="visually-hidden">Password</label>
          <input class="input" id="PwInput" type="password" name="password" autocomplete="current-password" placeholder="Password" required>
          <button class="btn btn--light" type="submit">Enter</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Password page", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }] }
{% endschema %}

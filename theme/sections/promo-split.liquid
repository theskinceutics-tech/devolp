{%- liquid
  assign s = section.settings
  assign product = s.product
  if product == blank and s.image == blank
    assign product = collections.all.products[1] | default: collections.all.products.first
  endif
-%}
<section class="reveal">
  <div class="promo">
    <div class="promo__content">
      <div style="max-width:560px;margin-left:auto;margin-right:0">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        <h2>{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
        <div class="split__actions">{%- render 'button', label: s.button_label, link: s.button_link, variant: 'outline' -%}</div>
      </div>
    </div>
    <div class="promo__media">
      {%- render 'media', image: s.image, product: product, ratio: '16/10', sizes: '(min-width: 900px) 45vw, 100vw', variant: 3 -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Promotion band",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent PNG product shots look best. Falls back to the product image." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover our advanced serums" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Concentrated, targeted formulas designed to fit into a simple daily routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop serums" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" }
  ],
  "presets": [{ "name": "Promotion band" }]
}
{% endschema %}

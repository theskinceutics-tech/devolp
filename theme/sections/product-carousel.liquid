{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collections.all
  endif
  assign dark = false
  if s.style == 'dark'
    assign dark = true
  endif
  assign view_link = s.view_all_link | default: source.url
-%}
<section class="section {% render 'section-class', style: s.style %} reveal">
  <div class="container">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="section-head">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2>{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p style="font-weight:600;color:inherit">{{ s.subheading | escape }}</p>{%- endif -%}
        {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
        {%- capture intro_url -%}{%- render 'safe-url', url: s.intro_link -%}{%- endcapture -%}
        {%- assign intro_url = intro_url | strip -%}
        {%- if s.intro_link_label != blank and intro_url != blank -%}<a href="{{ intro_url }}" class="link-arrow">{{ s.intro_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if source.products_count > 0 -%}
      <div class="carousel" data-carousel style="--per-view:{{ s.per_view }}">
        <div class="carousel__track" data-carousel-track tabindex="0" role="region" aria-label="{{ s.heading | default: source.title | escape }}">
          {%- for product in source.products limit: s.limit -%}
            <div>{%- render 'product-card', product: product, sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 45vw, 78vw' -%}</div>
          {%- endfor -%}
        </div>
        {%- render 'carousel-controls' -%}
      </div>
      {%- if s.view_all_label != blank -%}
        <div class="section-foot">{%- render 'button', label: s.view_all_label, link: view_link, variant: 'outline', dark: dark -%}</div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      <p class="text-center muted">Select a collection with products for this carousel.</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our best sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "intro_link_label", "label": "Intro link label" },
    { "type": "url", "id": "intro_link", "label": "Intro link" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Uses all products when empty." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "per_view", "label": "Cards per view (desktop)", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "view_all_link", "label": "Button link", "info": "Defaults to the collection." },
    { "type": "select", "id": "style", "label": "Background", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }, { "value": "blue", "label": "Light blue" }, { "value": "dark", "label": "Dark" }] }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}

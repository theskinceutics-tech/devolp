{%- liquid
  assign s = section.settings
  assign eager = false
  if section.index == 1
    assign eager = true
  endif
  assign dark_text = false
  if s.text_color == 'dark'
    assign dark_text = true
  endif
  assign product = s.product
  if product == blank
    assign product = collections.all.products.first
  endif
  case s.height
    when 'small'
      assign h = '480px'
      assign hm = '440px'
    when 'large'
      assign h = '720px'
      assign hm = '600px'
    else
      assign h = '620px'
      assign hm = '520px'
  endcase
  assign tag = 'h2'
  if section.index == 1
    assign tag = 'h1'
  endif
-%}
{%- if s.image != blank -%}
<section class="hero{% if dark_text %} hero--light{% endif %}{% if s.stack_mobile %} hero--stack-mobile{% endif %}" style="--hero-h:{{ h }};--hero-h-m:{{ hm }};--overlay:{{ s.overlay | divided_by: 100.0 }};--hero-fg:{% if dark_text %}var(--c-ink){% else %}#fff{% endif %};--focal:{{ s.image.presentation.focal_point | default: 'center' }}">
  <div class="hero__media">
    <picture>
      {%- if s.image_mobile != blank -%}
        <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 600 }} 600w, {{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ s.image_mobile.width }}" height="{{ s.image_mobile.height }}">
      {%- endif -%}
      {%- assign hero_alt = s.image.alt | default: s.heading -%}
      {%- render 'image', image: s.image, sizes: '100vw', eager: eager, widths: '750,1100,1500,1920,2400', alt: hero_alt -%}
    </picture>
  </div>
  <div class="container hero__inner" style="justify-content:{% if s.align == 'center' %}center;text-align:center{% else %}flex-start{% endif %}">
    <div class="hero__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow" style="color:inherit">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <{{ tag }}>{{ s.heading | escape }}</{{ tag }}>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
      <div class="hero__actions"{% if s.align == 'center' %} style="justify-content:center"{% endif %}>
        {%- render 'button', label: s.button_label, link: s.button_link, dark: dark_text, variant: 'primary' -%}
        {%- render 'button', label: s.button2_label, link: s.button2_link, dark: dark_text, variant: 'outline' -%}
      </div>
    </div>
  </div>
</section>
{%- if dark_text -%}<style>#shopify-section-{{ section.id }} .hero .btn--light{--btn-bg:var(--c-ink);--btn-fg:#fff;--btn-bd:var(--c-ink)}</style>{%- endif -%}
{%- else -%}
<section class="hero hero--product" style="--hero-bg:var(--grad-blue);--hero-h:{{ h }};--hero-h-m:{{ hm }}">
  <div class="container hero__inner">
    <div class="hero__content">
      {%- if s.eyebrow != blank -%}<span class="eyebrow" style="color:#bcd6f2">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <{{ tag }}>{{ s.heading | escape }}</{{ tag }}>
      {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
      <div class="hero__actions">
        {%- render 'button', label: s.button_label, link: s.button_link, dark: true -%}
        {%- render 'button', label: s.button2_label, link: s.button2_link, dark: true, variant: 'outline' -%}
      </div>
    </div>
    <div class="hero__product">
      {%- if product.featured_media -%}
        <div class="media media--contain" style="--ratio:1/1">{%- assign hero_alt = product.featured_media.alt | default: product.title -%}{%- render 'image', image: product.featured_media.preview_image, sizes: '(min-width: 900px) 50vw, 90vw', eager: eager, widths: '400,600,800,1000,1200', alt: hero_alt -%}</div>
      {%- else -%}
        <div class="media" style="--ratio:1/1;background:transparent">{%- render 'art', variant: 1, tone: 'dark' -%}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image", "info": "1920 × 700–900px. Without an image, the hero shows the selected product on a brand-blue gradient." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "900 × 1100–1300px, cropped for phones." },
    { "type": "product", "id": "product", "label": "Product (used when no image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Advanced skincare, backed by science" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Targeted formulas for skin and hair, developed by Elysium Skin Sciences." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/all" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "select", "id": "text_color", "label": "Text color on image", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "dark", "label": "Dark" }] },
    { "type": "select", "id": "align", "label": "Content alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }] },
    { "type": "range", "id": "overlay", "label": "Image overlay strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "checkbox", "id": "stack_mobile", "label": "Show text below image on mobile", "default": true }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}

{%- liquid
  assign s = section.settings
  assign steps = product.metafields.custom.how_to_use.value
  assign text = product.metafields.custom.how_to_use_text.value
-%}
{%- if steps != blank or text != blank -%}
<section class="section {% render 'section-class', style: s.style %} reveal" id="HowToUse">
  <div class="container">
    <div class="section-head"><h2>{{ s.heading | replace: '[product]', product.title | escape }}</h2></div>
    <div class="split">
      <div class="split__media">
        {%- assign img = product.metafields.custom.how_to_use_image.value | default: product.media[1].preview_image | default: product.featured_media.preview_image -%}
        <div class="media media--contain" style="--ratio:4/3;background:var(--grad-light)">{%- if img -%}{%- render 'image', image: img, sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title -%}{%- else -%}{%- render 'art', variant: 3 -%}{%- endif -%}</div>
      </div>
      <div class="split__content">
        {%- if steps != blank -%}
          <ol class="steps">
            {%- for st in steps -%}
              {%- assign parts = st | split: '|' -%}
              <li>
                {%- if parts.size > 1 -%}<strong>{{ parts[0] | strip | escape }}</strong><span>{{ st | remove_first: parts[0] | remove_first: '|' | strip | escape }}</span>{%- else -%}<span>{{ st | escape }}</span>{%- endif -%}
              </li>
            {%- endfor -%}
          </ol>
        {%- else -%}
          <div class="rte">{{ text | escape | newline_to_br }}</div>
        {%- endif -%}
        {%- if product.metafields.custom.caution.value != blank -%}<p class="form-message" style="margin-top:20px">{{ product.metafields.custom.caution.value | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "How to use",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to use [product]" },
    { "type": "select", "id": "style", "label": "Background", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "surface", "label": "Light grey" }] },
    { "type": "paragraph", "content": "Metafields: custom.how_to_use (list, format: Step title | Instruction) or custom.how_to_use_text (multi-line), custom.how_to_use_image (file), custom.caution (single line). Uses only your official directions." }
  ]
}
{% endschema %}

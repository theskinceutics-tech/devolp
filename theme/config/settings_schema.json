[
  {
    "name": "theme_info",
    "theme_name": "Elysium Clinical",
    "theme_version": "1.0.0",
    "theme_author": "Elysium Skin Sciences",
    "theme_documentation_url": "https://elysiumskinsciences.com/",
    "theme_support_url": "https://elysiumskinsciences.com/pages/contact"
  },
  {
    "name": "Logo",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo (light version for dark header)" },
      { "type": "image_picker", "id": "logo_dark", "label": "Logo (dark version for light backgrounds)", "info": "Used on the password page and light surfaces. Falls back to the main logo." },
      { "type": "range", "id": "logo_width", "label": "Desktop logo width", "min": 80, "max": 300, "step": 5, "unit": "px", "default": 190 },
      { "type": "range", "id": "logo_width_mobile", "label": "Mobile logo width", "min": 60, "max": 220, "step": 5, "unit": "px", "default": 130 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 × 32px PNG recommended." }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_ink", "label": "Text", "default": "#111418" },
      { "type": "color", "id": "color_ink_soft", "label": "Secondary text", "default": "#4b5561" },
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#ffffff" },
      { "type": "color", "id": "color_surface", "label": "Light surface", "default": "#f3f5f8" },
      { "type": "color", "id": "color_surface_2", "label": "Light blue surface", "default": "#e4ecf5" },
      { "type": "color", "id": "color_dark", "label": "Dark sections and header", "default": "#0e1114" },
      { "type": "color", "id": "color_accent", "label": "Brand blue", "default": "#1c5fa8" },
      { "type": "color", "id": "color_accent_dark", "label": "Deep brand blue", "default": "#0f3866" },
      { "type": "color", "id": "color_line", "label": "Borders", "default": "#dde3ea" },
      { "type": "color", "id": "color_sale", "label": "Sale price", "default": "#a8231c" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "type_heading_font", "label": "Headings", "default": "montserrat_n6" },
      { "type": "font_picker", "id": "type_body_font", "label": "Body", "default": "montserrat_n4" },
      { "type": "range", "id": "type_body_size", "label": "Body text size", "min": 13, "max": 18, "step": 1, "unit": "px", "default": 15 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Maximum page width", "min": 1100, "max": 1440, "step": 20, "unit": "px", "default": 1320 },
      { "type": "checkbox", "id": "animations_reveal", "label": "Reveal sections on scroll", "default": true, "info": "Subtle fade. Disabled automatically for visitors who prefer reduced motion." }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Show Add to Cart button", "default": true },
      { "type": "checkbox", "id": "card_show_rating", "label": "Show product rating", "default": true, "info": "Uses the standard reviews.rating metafield written by Shopify-compatible review apps. Hidden when no rating exists." },
      { "type": "paragraph", "content": "Badges: add a product tag such as badge:Best Seller or badge:New to show a badge on the card. Sold out and Sale badges are automatic." }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart type", "options": [ { "value": "drawer", "label": "Drawer" }, { "value": "page", "label": "Page" } ], "default": "drawer" },
      { "type": "checkbox", "id": "cart_show_note", "label": "Enable order note", "default": false },
      { "type": "text", "id": "cart_message", "label": "Message under checkout button", "info": "Only add confirmed store terms, for example your real delivery policy." }
    ]
  },
  {
    "name": "Search",
    "settings": [
      { "type": "checkbox", "id": "predictive_search", "label": "Enable search suggestions", "default": true }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_whatsapp", "label": "WhatsApp chat link", "info": "For example https://wa.me/92XXXXXXXXXX" }
    ]
  }
]
